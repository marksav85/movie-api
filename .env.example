# Local/development MongoDB connection only. Never use production credentials in tests.
CONNECTION_URI=mongodb://127.0.0.1:27017/movie-api

# Use production in deployed environments; production requires CORS_ALLOWED_ORIGINS.
NODE_ENV=development

# Required for JWT signing and verification. Replace with a unique random value
# of at least 32 bytes; this example value is deliberately rejected at runtime.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated explicit browser origins. Production must provide this value;
# local development otherwise supports the React Parcel (1234) and Angular (4200) servers.
CORS_ALLOWED_ORIGINS=http://localhost:1234,http://localhost:4200

# Small JSON/profile requests only. Bodies above 16kb receive 413.
JSON_BODY_LIMIT=16kb

# Login is limited to 10 attempts per client IP each 15 minutes. The broader API
# limit is intentionally modest for normal portfolio-client usage.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000

# Optional HTTP listener port. Defaults to 8080.
PORT=8080

# Direct/local traffic does not trust forwarded headers.
TRUST_PROXY_HOPS=0
